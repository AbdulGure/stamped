# Explicit choice; never silently import demo data into a real account.
NEXT_PUBLIC_DATA_MODE=local
# In cloud mode use the project URL and browser-safe publishable key from Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is accepted as an alternative to the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never add a service_role / sb_secret key here.
# Optional old integration; current vector map requires no Mapbox token.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
